<Project>
  <!-- OneDrive locks Builds\...\*.tlog and MSB3374 fires when MSBuild stamps lastbuildstate. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
    <TLogLocation>$(LOCALAPPDATA)\F4RT\tlog\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</TLogLocation>
  </PropertyGroup>
</Project>
